# Copy to .env and fill in only what you need. Never commit .env.
#
# The weather features need NOTHING here. Open-Meteo's free non-commercial API
# requires no key and no account. Everything below is optional; when a value is
# absent the app disables that feature cleanly and keeps running.

# ---------------------------------------------------------------- backend
# Comma-separated list, or * in development.
CORS_ORIGINS=*
HTTP_TIMEOUT=12

# Reverse geocoding (coordinates -> place name) for the "use my location" flow,
# via OpenStreetMap Nominatim. No key needed. Their usage policy asks for an
# identifying User-Agent and at most one request per second; both are honoured.
# Point NOMINATIM_URL at your own instance if you expect real traffic.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=MeinKaivinai/1.0 (heat-risk early warning, Tamil Nadu)
REVERSE_GEOCODE_MIN_INTERVAL=1.0
CACHE_TTL_SECONDS=600
MAX_CONCURRENT_FETCHES=6

# How far a searched point may sit from a ward centroid and still count as
# inside that ward. Beyond this the app falls back to the area forecast.
WARD_MATCH_RADIUS_KM=6
DEFAULT_CITY=Madurai
DEFAULT_WARD_ID=mdu-meenakshi

# ------------------------------------------------- Firebase (optional, server)
# FIREBASE_PROJECT_ID alone is enough to VERIFY sign-ins: ID tokens are checked
# against Google's public certificates, so no service-account key is needed for
# authentication. Absent => sign-in is switched off and every privileged route
# returns 401; the weather path is unaffected.
FIREBASE_PROJECT_ID=

# Only needed for Firebase Cloud Messaging push, which is not implemented.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------ roles & auth
# Demo identity mode, ON BY DEFAULT so the three-role workflow works with no
# setup. The server accepts an unsigned "X-Dev-User: uid|role|Area|Name" header,
# which is what the in-app role switcher sends.
#
# Roles and jurisdictions are still enforced server-side in this mode. What is
# NOT enforced is identity: anyone can claim any role. /api/status reports
# auth.mode = "demo-identity" and the app shows a banner.
#
# Set to 0 in production to require verified Firebase tokens and nothing else.
DEV_AUTH=1

# Server-side role assignments, used when a token carries no role claim.
# Copy backend/app/data/role_registry.example.json alongside it and edit.
# Roles are never self-service.
ROLE_REGISTRY_PATH=backend/app/data/role_registry.json

# ------------------------------------------------------------- persistence
# Alerts, the transition audit log, ward subscriptions and the in-app inbox.
# JSON file by default so there is no database to install. Swap the Repository
# implementation in backend/app/services/store.py for Firestore when needed.
STORE_PATH=backend/data/store.json

# Hard cap so a bug cannot fan one alert out to an unbounded audience.
MAX_RECIPIENTS_PER_ALERT=20000

# ----------------------------------------------------- SMS gateway (NOT WIRED)
# SMS is switched off in this build and the code path is not implemented.
# Transactional SMS in India requires DLT registration of the sending entity,
# a 6-character header and every message template, under TRAI rules. That is an
# out-of-band approval process, not a coding task -- see the README.
# Setting these will NOT make SMS work; the UI continues to report
# "not configured - nothing sent", which is the truth.
SMS_ENABLED=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# --------------------------------------------------- ERA5 history (optional)
# Absent => historical baselines are unavailable. Live forecasting is unaffected
# and startup never waits on this.
ERA5_CDS_API_KEY=

# ------------------------------------------------- Firebase (optional, client)
# Vite exposes these to the browser, so use only the public web-app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
